{
  "metadata": {
    "project": "Nesy (NASA Space Apps 2026)",
    "version": "1.1",
    "description": "Baseline lunar target-zone parameters calibrated from NASA PDS / LRO QuickMap orbital datasets, used to rank terrestrial analog sites.",
    "disclaimer": "Target parameters are calibrated from LRO QuickMap spatial statistics (LOLA, Diviner, M3, Lunar Prospector) and harmonised to Earth-candidate feature definitions.",
    "data_sources": {
      "LOLA": "LRO Lunar Orbiter Laser Altimeter - slope, roughness, topography, 1064 nm normal albedo (PDS Geosciences Node)",
      "Diviner": "LRO Diviner Lunar Radiometer - bolometric & regolith temperature, diurnal/seasonal range, thermal inertia / rock abundance",
      "M3": "Chandrayaan-1 Moon Mineralogy Mapper - pyroxene/olivine 1 um & 2 um band parameters",
      "Lunar Prospector": "Lunar Prospector Gamma-Ray & Neutron Spectrometer - FeO wt% abundance and deconvolved hydrogen (ug/g)",
      "Mini-RF": "LRO Mini-RF S-band radar - circular polarization ratio (CPR) used as subsurface ice / blockiness indicator",
      "CRaTER": "LRO Cosmic Ray Telescope for the Effects of Radiation - surface GCR dose-rate",
      "Mars benchmark": "MRO CRISM / HiRISE / MOLA / THEMIS and MSL-RAD (Jezero via Mars 2020 landing-site analyses)"
    },
    "feature_definitions": {
      "slope_deg": "Mean surface slope [deg]",
      "tri_m": "Terrain Ruggedness Index [m]",
      "delta_t_k": "Surface temperature amplitude (Tmax - Tmin) [K]",
      "mafic_index": "Dimensionless mafic/felsic ratio proxy (1.00 = felsic/anorthositic baseline, >1.3 = basaltic)",
      "clay_hydrated_index": "Normalised hydration / phyllosilicate band-depth index",
      "subsurface_ice_moisture": "Volumetric/weight-fraction proxy for near-surface water ice or moisture (0-1)",
      "albedo": "Normal-incidence broadband albedo (0-1)",
      "thermal_inertia_proxy": "Thermal inertia [J m^-2 K^-1 s^-1/2]",
      "radiation_flux_msv_yr": "Surface galactic-cosmic-ray (GCR) effective dose, unshielded [mSv/yr]"
    },
    "similarity_features": [
      "slope_deg",
      "tri_m",
      "delta_t_k",
      "mafic_index",
      "clay_hydrated_index",
      "subsurface_ice_moisture",
      "albedo",
      "thermal_inertia_proxy"
    ]
  },
